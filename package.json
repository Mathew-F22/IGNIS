{
  "name": "ignis",
  "version": "2.0.0",
  "private": true,
  "description": "IGNIS — Identify Gaps and Navigate Ideas to Solutions",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --env-file-if-exists=.env --no-warnings server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node --env-file-if-exists=.env --no-warnings server/index.js",
    "serve": "node --env-file-if-exists=.env --no-warnings server/index.js",
    "seed": "node --env-file-if-exists=.env --no-warnings server/seed.js",
    "dev:watch": "concurrently -k -n api,web -c blue,magenta \"node --env-file-if-exists=.env --no-warnings --watch-path=server --watch-path=shared server/index.js\" \"vite\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "html-to-image": "^1.11.11",
    "lucide-react": "^1.77.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.8",
    "xlsx": "^0.18.5"
  }
}
