# Copie para .env (opcional). Tudo funciona sem este arquivo.
PORT=4000
# Endereço que aparece nos links de recuperação de senha (ex.: http://192.168.0.10:4000)
APP_URL=
# E-mail de recuperação de senha (opcional). Sem SMTP, o pedido vai para o login mestre.
# Ex. Gmail gratuito: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=sua.conta@gmail.com, SMTP_PASS=<senha de app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
